      "item": [
        {
          "name": "Listar tipos de usuario - GET /api/user-types",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/user-types"
          }
        },
        {
          "name": "Buscar tipo de usuario por ID - GET /api/user-types/:id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/user-types/{{userTypeClienteId}}"
          }
        },
        {
          "name": "Criar tipo de usuario - POST /api/user-types",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "try {",
                  "  const json = pm.response.json();",
                  "  if (json && json.id) {",
                  "    pm.collectionVariables.set('createdUserTypeId', json.id);",
                  "  }",
                  "} catch (e) {",
                  "  console.error('Erro ao atualizar createdUserTypeId:', e);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cliente Postman\",\n  \"code\": \"CLIENTE\"\n}"
            },
            "url": "{{baseUrl}}/api/user-types",
            "description": "O campo code aceita os valores do enum: DONO_RESTAURANTE ou CLIENTE. Se ja existir registro com o mesmo codigo no banco, o banco pode retornar conflito de unicidade."
          }
        },
        {
          "name": "Atualizar tipo de usuario - PUT /api/user-types/:id",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cliente Atualizado\",\n  \"code\": \"CLIENTE\"\n}"
            },
            "url": "{{baseUrl}}/api/user-types/{{createdUserTypeId}}"
          }
